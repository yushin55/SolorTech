# Local single-user development. Compose reads this file after copying to .env.
# Native uvicorn: set these as shell variables as shown in README.
STORAGE_BACKEND=local
LOCAL_DB_PATH=./data/solar.sqlite3
SEED_DEMO=true
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Optional Firestore emulator: docker compose --profile firebase up --build
# Set STORAGE_BACKEND=firestore and FIRESTORE_EMULATOR_HOST=firebase:8080
# for the backend container. Native backend uses 127.0.0.1:8080 instead.
FIREBASE_PROJECT_ID=demo-solar-local
FIRESTORE_COLLECTION_PREFIX=solar_
FIRESTORE_EMULATOR_HOST=

# Real Firestore: set your project ID, leave FIRESTORE_EMULATOR_HOST empty,
# and set GOOGLE_APPLICATION_CREDENTIALS to the server-side JSON key path.
# Never put a private key in a frontend VITE_* variable or commit a key file.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/firebase-service-account.json

# Frontend dev-server proxy target inside Docker. Local default is 127.0.0.1:8000.
API_PROXY_TARGET=http://backend:8000

# Region/city search works offline by default, without a key or external request.
GEOCODING_PROVIDER=local
# Apartment/building/address search (recommended for Korea): create a REST API key at
# https://developers.kakao.com (내 애플리케이션 > 앱 키 > REST API 키), then set both lines.
# GEOCODING_PROVIDER=kakao
# KAKAO_REST_API_KEY=
# Optional OSM address lookup instead: review the policy in docs/references.md first.
# GEOCODING_PROVIDER=nominatim

# "이 지역 수면 찾기" sends only the visible map rectangle to public OpenStreetMap
# Overpass servers on click, and caches results in backend/data/water-cache for 30 days.
# Set to off to disable the feature.
WATER_PROVIDER=overpass
